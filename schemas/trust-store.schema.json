{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huffman:cas-xdp:trust-store:1.0",
  "title": "CAS-XDP Local Publisher Trust Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys", "revocations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publisher_id", "key_id", "algorithm", "public_key", "status"],
        "properties": {
          "publisher_id": { "type": "string", "minLength": 1 },
          "key_id": { "type": "string", "minLength": 1 },
          "algorithm": { "const": "Ed25519" },
          "public_key": { "type": "string", "contentEncoding": "base64", "minLength": 1 },
          "status": { "enum": ["trusted", "untrusted"] }
        }
      }
    },
    "revocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publisher_id", "key_id", "revoked_at", "reason"],
        "properties": {
          "publisher_id": { "type": "string", "minLength": 1 },
          "key_id": { "type": "string", "minLength": 1 },
          "revoked_at": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
