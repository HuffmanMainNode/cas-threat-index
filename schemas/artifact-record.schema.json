{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huffman:cas-xdp:artifact-record:1.0",
  "title": "CAS-XDP Signed Artifact Provenance Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "publisher", "signature"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256", "size_bytes", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "commit", "license_spdx"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "commit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
            "license_spdx": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$" }
          }
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "value": { "type": "string", "contentEncoding": "base64", "minLength": 1 }
      }
    }
  }
}
